{
  "schemaVersion": 1,
  "id": "action",
  "version": "${version}",
  "name": "action",
  "description": "Adds a multiplayer action panel, player poses, and custom collision boxes.",
  "authors": [
    "Daxia"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/action/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.daxia.action.ActionMod"
    ],
    "client": [
      "com.daxia.action.client.ActionClient"
    ]
  },
  "mixins": [
    "action.mixins.json",
    {
      "config": "action.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
